#!/usr/bin/env bash
set -euo pipefail
plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
omarchy_path=${OMARCHY_PATH:-/home/panda/.local/share/omarchy-overlay}
shell_root=${OMARCHY_SHELL_ROOT:-$omarchy_path/shell}
qmllint_bin=${QMLLINT:-/usr/lib/qt6/bin/qmllint}
[[ -x "$qmllint_bin" ]] || { printf 'Qt 6 qmllint not found: %s\n' "$qmllint_bin" >&2; exit 1; }
# The runtime runner places harnesses beside the production components.
# Match that owned topology rather than compiling a nested test directory.
lint_dir=$(mktemp -d)
trap 'rm -rf -- "$lint_dir"' EXIT
find "$plugin_dir" -maxdepth 1 -type f \
  \( -name '*.qml' -o -name '*.js' -o -name qmldir -o -name .qmllint.ini \) \
  -exec cp -- '{}' "$lint_dir/" \;
cp -- "$plugin_dir/tests/qml/RuntimePaletteContractTest.qml" \
  "$plugin_dir/tests/qml/RuntimeIpcTransportTest.qml" "$lint_dir/"
cd "$lint_dir"
qml_import_args=(-I "$shell_root" -I .)
if [[ -n ${QML_TOOLING_IMPORT_ROOT:-} ]]; then
  qml_import_args=(--bare -I "$QML_TOOLING_IMPORT_ROOT" -I "$shell_root" -I . -I /usr/lib/qt6/qml)
fi
"$qmllint_bin" "${qml_import_args[@]}" -i "$lint_dir/qmldir" \
  -i "$shell_root/Commons/qmldir" -i "$shell_root/Ui/qmldir" \
  Button.qml WidgetButton.qml BarHostAccess.qml BarWidget.qml SettingsPanel.qml Service.qml \
  RuntimePaletteContractTest.qml RuntimeIpcTransportTest.qml
python3 "$plugin_dir/scripts/check-qml-lint-controls.py" --qmllint "$qmllint_bin" \
  --shell-root "$shell_root" --policy "$plugin_dir/.qmllint.ini"
